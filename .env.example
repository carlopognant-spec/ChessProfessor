# Provider LLM da usare per le spiegazioni del chatbot: "gemini" oppure "groq"
VITE_LLM_PROVIDER=groq

# Chiave API Groq (https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# Modello Groq — verifica su https://console.groq.com/docs/models
# llama-3.3-70b-versatile è decommissionato (16/08/2026) sul tier free/developer
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Chiave API Gemini (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# Modello Gemini — alias sempre ripuntato al Flash corrente
VITE_GEMINI_MODEL=gemini-flash-latest

# Token Lichess (https://lichess.org/account/oauth/token) — usato dall'Opening Explorer
VITE_LICHESS_TOKEN=

# NOTA IMPORTANTE: in produzione su GitHub Pages, queste chiavi finiscono
# nel bundle JS pubblico e sono estraibili da chiunque. Vanno bene per
# sviluppo locale / uso personale. Per un deploy pubblico servirà un
# piccolo proxy serverless (es. Cloudflare Workers) che nasconda la chiave.
